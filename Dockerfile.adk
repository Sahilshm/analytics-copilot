FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY adk_agents ./adk_agents
COPY adk_main.py ./

RUN pip install --no-cache-dir -e ".[cloud,adk]"

CMD ["uvicorn", "adk_main:app", "--host", "0.0.0.0", "--port", "8080"]
